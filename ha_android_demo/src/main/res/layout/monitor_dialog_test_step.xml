<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data class="TestStepBinding">

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="54dp"
        android:background="@drawable/monitor_shape_dialog_bg">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/monitor_test_step"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            android:textColor="@color/monitor_color_text_black"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <ImageView
            android:id="@+id/ivClose"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/monitor_close"
            app:layout_constraintTop_toTopOf="@id/tvTitle"
            app:layout_constraintBottom_toBottomOf="@id/tvTitle"
            android:contentDescription="@string/monitor_close"
            app:layout_constraintEnd_toEndOf="parent"/>

        <View
            android:id="@+id/vLine"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:background="#E6E8FD"
            app:layout_constraintStart_toStartOf="@id/vOneBg"
            app:layout_constraintTop_toTopOf="@id/vOneBg"
            app:layout_constraintEnd_toEndOf="@id/vOneBg"
            app:layout_constraintBottom_toBottomOf="@id/vFourBg"/>

        <View
            android:id="@+id/vOneBg"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="25dp"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            android:background="@drawable/monitor_point" />

        <TextView
            android:id="@+id/tvOne"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="@id/vOneBg"
            app:layout_constraintBottom_toBottomOf="@id/vOneBg"
            app:layout_constraintEnd_toEndOf="@id/vOneBg" />

        <TextView
            android:id="@+id/tvStepOneTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/monitor_print_log"
            android:textColor="@color/monitor_color_text_black"
            android:layout_marginStart="8dp"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="3dp"
            app:layout_constraintTop_toTopOf="@id/vOneBg"
            app:layout_constraintStart_toEndOf="@id/vOneBg"
            app:layout_constraintBottom_toBottomOf="@id/vOneBg"/>

        <TextView
            android:id="@+id/tvStepOneDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/monitor_local_print_log"
            android:textColor="@color/monitor_color_text_gray"
            android:textSize="16sp"
            android:layout_marginTop="2dp"
            app:layout_constraintStart_toStartOf="@id/tvStepOneTitle"
            app:layout_constraintTop_toBottomOf="@id/tvStepOneTitle"/>

        <View
            android:id="@+id/vTwoBg"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="57dp"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/vOneBg"
            android:background="@drawable/monitor_point" />

        <TextView
            android:id="@+id/tvTwo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="@id/vTwoBg"
            app:layout_constraintBottom_toBottomOf="@id/vTwoBg"
            app:layout_constraintEnd_toEndOf="@id/vTwoBg" />

        <TextView
            android:id="@+id/tvStepTwoTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/monitor_build_task"
            android:textColor="@color/monitor_color_text_black"
            android:layout_marginStart="8dp"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="3dp"
            app:layout_constraintTop_toTopOf="@id/vTwoBg"
            app:layout_constraintStart_toEndOf="@id/vTwoBg"
            app:layout_constraintBottom_toBottomOf="@id/vTwoBg"/>

        <TextView
            android:id="@+id/tvStepTwoDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/monitor_build_task_desc"
            android:textColor="@color/monitor_color_text_gray"
            android:textSize="16sp"
            android:layout_marginTop="2dp"
            app:layout_constraintStart_toStartOf="@id/tvStepTwoTitle"
            app:layout_constraintTop_toBottomOf="@id/tvStepTwoTitle"/>

        <View
            android:id="@+id/vThreeBg"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="57dp"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/vTwoBg"
            android:background="@drawable/monitor_point" />

        <TextView
            android:id="@+id/tvThree"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="@id/vThreeBg"
            app:layout_constraintBottom_toBottomOf="@id/vThreeBg"
            app:layout_constraintEnd_toEndOf="@id/vThreeBg" />

        <TextView
            android:id="@+id/tvStepThreeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/monitor_upload_log"
            android:textColor="@color/monitor_color_text_black"
            android:layout_marginStart="8dp"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="3dp"
            app:layout_constraintTop_toTopOf="@id/vThreeBg"
            app:layout_constraintStart_toEndOf="@id/vThreeBg"
            app:layout_constraintBottom_toBottomOf="@id/vThreeBg"/>

        <TextView
            android:id="@+id/tvStepThreeDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/monitor_upload_log_desc"
            android:textColor="@color/monitor_color_text_gray"
            android:textSize="16sp"
            android:layout_marginTop="2dp"
            app:layout_constraintStart_toStartOf="@id/tvStepThreeTitle"
            app:layout_constraintTop_toBottomOf="@id/tvStepThreeTitle"/>

        <View
            android:id="@+id/vFourBg"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="57dp"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/vThreeBg"
            android:background="@drawable/monitor_point" />

        <TextView
            android:id="@+id/tvFour"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="@id/vFourBg"
            app:layout_constraintBottom_toBottomOf="@id/vFourBg"
            app:layout_constraintEnd_toEndOf="@id/vFourBg" />

        <TextView
            android:id="@+id/tvStepFourTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/monitor_look_log"
            android:textColor="@color/monitor_color_text_black"
            android:layout_marginStart="8dp"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="3dp"
            app:layout_constraintTop_toTopOf="@id/vFourBg"
            app:layout_constraintStart_toEndOf="@id/vFourBg"
            app:layout_constraintBottom_toBottomOf="@id/vFourBg"/>

        <TextView
            android:id="@+id/tvStepFourDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/monitor_look_log_desc"
            android:textColor="@color/monitor_color_text_gray"
            android:textSize="16sp"
            android:layout_marginTop="2dp"
            app:layout_constraintStart_toStartOf="@id/tvStepFourTitle"
            app:layout_constraintTop_toBottomOf="@id/tvStepFourTitle"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>